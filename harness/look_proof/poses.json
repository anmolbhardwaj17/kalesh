{
  "_doc": "Look proof views (harness/bin/lookproof.mjs). Each view is a fresh game run at its size: it loads a stand-in scene (P0-009: street, landmarks, areas), puts the debug camera at a fixed pose (hud_play keeps the chase camera and the HUD), lets 1 s of sim pass, then holds the sim (hold at 0 pauses at once) so every run shoots the same moment. The scenes are seeded and static.",
  "views": [
    {
      "name": "car_closeup",
      "size": [
        1920,
        1080
      ],
      "_note": "The player car stand-in up close, front three quarter, at the kerb side of the arterial.",
      "steps": [
        {
          "call": "load",
          "args": [
            "street"
          ],
          "timeout": 90000
        },
        {
          "call": "setCamera",
          "args": [
            {
              "pos": [
                -2.6,
                1.05,
                70.6
              ],
              "target": [
                -5.85,
                0.65,
                75.2
              ]
            }
          ]
        },
        {
          "call": "hud",
          "args": [
            false
          ]
        },
        {
          "settle": 1
        },
        {
          "call": "hold",
          "args": [
            {
              "at": 0
            }
          ]
        },
        {
          "waitFor": "window.__game.debug.clock().paused === true",
          "timeout": 10000
        }
      ]
