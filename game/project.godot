; Engine configuration file for Kalesh, Godot 4.7.2 (pinned in harness/kit.config.json "godot").
; Coordinates are binding (harness/design/TECH.md "Coordinates"): east +X, north -Z, up +Y, 1 unit = 1 metre.
; No negative scale and no axis flips anywhere. The physics tick is fixed at 60 Hz (C1: SimClock sets the rate per time scale).
; Physics is Jolt by name: DEFAULT resolves to GodotPhysics3D on 4.7.2 (P0-017); game/tests/test_sim_clock.gd checks it.

config_version=5

[application]

config/name="Kalesh"
config/version="0.0.1"
config/description="Open world driving in Delhi. Stand-in scaffold."
run/main_scene="res://scenes/city.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameArgs="*res://core/game_args.gd"
SimClock="*res://core/sim_clock.gd"
GameEvents="*res://core/game_events.gd"
DayClock="*res://core/day_clock.gd"
FpsCounter="*res://ui/fps_counter.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

