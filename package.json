    "earcut": "^3.2.4",
    "geotiff": "^3.0.5",
    "harfbuzzjs": "^1.6.4",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "three": "^0.170.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
